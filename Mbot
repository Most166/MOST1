// ─── ดึงเพลงที่เกี่ยวข้องจาก YouTube สำหรับ autoplay ────────────────────────

function ytGetRelated(url, history = new Set()) {
    return new Promise((resolve, reject) => {
        let videoId = null;
        try {
            const parsed = new URL(url);
            videoId = parsed.searchParams.get('v') || parsed.pathname.split('/').pop();
        } catch {
            return reject(new Error('URL ไม่ถูกต้อง'));
        }

        if (!videoId) return reject(new Error('ไม่พบ video ID'));

        let data = '';
        const proc = spawn('yt-dlp', [
            '--dump-json',
            '--quiet',
            '--no-warnings',
            '--flat-playlist',
            '--playlist-items', '2-10',
            `https://www.youtube.com/watch?v=${videoId}&list=RD${videoId}`
        ]);

        proc.stdout.on('data', chunk => data += chunk);
        proc.stderr.on('data', () => {});
        proc.on('error', reject);

        proc.on('close', () => {
            const lines = data.trim().split('\n').filter(Boolean);
            if (!lines.length) return reject(new Error('ไม่พบเพลงที่เกี่ยวข้อง'));

            const candidates = [];
            for (const line of lines) {
                try {
                    const item = JSON.parse(line);
                    const itemUrl = item.url || `https://www.youtube.com/watch?v=${item.id}`;
                    const itemId = item.id || new URL(itemUrl).searchParams.get('v');
                    if (itemId && !history.has(itemId)) {
                        candidates.push({
                            id: itemId,
                            title: item.title || 'Unknown',
                            url: itemUrl,
                            duration: formatSeconds(item.duration || 0),
                            thumbnail: item.thumbnails?.[0]?.url || null,
                            uploader: item.uploader || item.channel || 'Unknown'
                        });
                    }
                } catch { /* skip parse error */ }
            }

            if (!candidates.length) return reject(new Error('ไม่มีเพลงใหม่ที่ยังไม่เคยเล่น'));
            const pick = candidates[Math.floor(Math.random() * candidates.length)];
            resolve(pick);
        });
    });
}

// ─── ค้นหาเพลง ───────────────────────────────────────────────────────────────

function ytSearch(query) {
    return new Promise((resolve, reject) => {
        const isUrl = /^https?:\/\//.test(query);
        const target = isUrl ? query : `ytsearch1:${query}`;

        let data = '';
        const proc = spawn('yt-dlp', [
            '--dump-json',
            '--no-playlist',
            '--quiet',
            '--no-warnings',
            target
        ]);

        proc.stdout.on('data', chunk => data += chunk);
        proc.stderr.on('data', () => {});
        proc.on('error', reject);

        proc.on('close', code => {
            if (code !== 0 || !data.trim()) return reject(new Error('yt-dlp ไม่พบผลลัพธ์'));
            try {
                const info = JSON.parse(data.trim().split('\n')[0]);
                resolve({
                    title: info.title || 'Unknown',
                    url: info.webpage_url || info.url,
                    duration: formatSeconds(info.duration || 0),
                    thumbnail: info.thumbnail || null,
                    uploader: info.uploader || 'Unknown'
                });
            } catch {
                reject(new Error('parse ข้อมูลเพลงล้มเหลว'));
            }
        });
    });
}

// ─── สร้าง stream ผ่าน yt-dlp + ffmpeg (EPIPE safe) ─────────────────────────

function createYtdlpStream(url) {
    const proc = spawn('yt-dlp', [
        '-f', 'bestaudio[ext=webm]/bestaudio/best',
        '--no-playlist',
        '--quiet',
        '--no-warnings',
        '-o', '-',
        url
    ]);

    const ffmpeg = spawn('ffmpeg', [
        '-i', 'pipe:0',
        '-f', 's16le',
        '-ar', '48000',
        '-ac', '2',
        '-loglevel', 'quiet',
        'pipe:1'
    ]);

    proc.stdout.on('error', () => {});
    proc.stderr.on('data', () => {});
    proc.on('error', () => {});

    ffmpeg.stdin.on('error', () => {});
    ffmpeg.stderr.on('data', () => {});
    ffmpeg.stdout.on('error', () => {});
    ffmpeg.on('error', () => {});

    proc.stdout.pipe(ffmpeg.stdin);

    const cleanup = () => {
        try { proc.kill('SIGKILL'); } catch { /* already dead */ }
        try { ffmpeg.kill('SIGKILL'); } catch { /* already dead */ }
    };

    ffmpeg.stdout.on('end', cleanup);
    proc.on('close', () => {
        try { ffmpeg.stdin.end(); } catch { /* ignore */ }
    });

    return { stream: ffmpeg.stdout, type: StreamType.Raw, cleanup };
}

// ─── Utility ─────────────────────────────────────────────────────────────────

function formatSeconds(sec) {
    if (!sec || isNaN(sec)) return '?:??';
    const h = Math.floor(sec / 3600);
    const m = Math.floor((sec % 3600) / 60);
    const s = Math.floor(sec % 60);
    if (h > 0) return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    return `${m}:${String(s).padStart(2, '0')}`;
}

function chunkArray(arr, size) {
    const chunks = [];
    for (let i = 0; i < arr.length; i += size) chunks.push(arr.slice(i, i + size));
    return chunks;
}

function extractVideoId(url) {
    try {
        const parsed = new URL(url);
        return parsed.searchParams.get('v') || parsed.pathname.split('/').pop() || null;
    } catch { return null; }
}

